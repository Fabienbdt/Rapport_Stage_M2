@article{wan_scname_2022,
  title        = {{scNAME}: neighborhood contrastive clustering with ancillary mask estimation for {scRNA}-seq data},
  volume       = {38},
  rights       = {https://academic.oup.com/journals/pages/open\_access/funder\_policies/chorus/standard\_publication\_model},
